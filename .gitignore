# Text and log files (Databricks job logs, captured stdout/stderr, ad-hoc dumps)
*.log
*.log.gz
*.txt

# Python bytecode caches. The general `__*/` rule below covers __pycache__
# already; calling it out explicitly because it's the one that keeps biting.
__pycache__/

# Any other directory whose name starts with `__` (e.g. __MACOSX, ...).
# Files starting with __ (like __init__.py, __main__.py) are NOT matched
# because the trailing slash restricts the rule to directories.
__*/

# Python virtual env. `.venv/` (created by `python3 -m venv .venv`) and any
# similarly-named sibling layouts should never be tracked.
.venv/
venv/
env/

# setuptools / pip editable-install metadata.
*.egg-info/
build/
dist/

# Reports are generally ignored: they're huge encrypted blobs regenerated by
# the SPA and not meant to live in source control. The first demo report is
# the one exception -- keep it in git as a worked example. Anything else
# under reports/ is ignored.
reports/*
!reports/2026-05-27_2026-06-10/
reports/2026-05-27_2026-06-10/*
!reports/2026-05-27_2026-06-10/20260529-112130-13launches/

# runtime state -- not source; tracking it caused live-data loss
pipelines.json
groups.json
# Report Portal log caches written by the analyzer at generation time
logs/
*.bak
